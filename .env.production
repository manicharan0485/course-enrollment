# PRODUCTION ENVIRONMENT - Keep this secure!
# Never commit this to git

# Database Configuration - Production Server
DB_HOST=your-production-db-host
DB_NAME=course_enrollment_prod
DB_USER=prod_user
DB_PASS=your-very-secure-password-here

# Application Settings
APP_ENV=production
APP_URL=http://localhost/course-enrollment/

# Admin Email
ADMIN_EMAIL=admin@your-domain.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=/var/www/uploads/

# Session Settings
SESSION_TIMEOUT=3600
SESSION_NAME=course_enrollment_session

# Security - Production
CSRF_TOKEN_LENGTH=32
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Email Configuration (for notifications)
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your-email-password
